{
  "name": "trust-medical/same-origin-livewire-bridge",
  "description": "Same-origin-only bridge for embedding Laravel Livewire components into non-Laravel pages.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Trust Medical"
    },
    {
      "name": "Philo Hermans",
      "email": "me@philo.dev",
      "role": "Wire Extender original author"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0",
    "illuminate/http": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/support": "^12.0",
    "illuminate/validation": "^12.0",
    "livewire/livewire": "^4.3"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/framework": "^12.0",
    "laravel/pint": "^1.18",
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "TrustMedical\\SameOriginLivewireBridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "TrustMedical\\SameOriginLivewireBridge\\SameOriginLivewireBridgeServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --debug --no-progress --memory-limit=512M",
    "format": "pint"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
